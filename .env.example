# Where consultation requests are delivered
MAIL_TO=a4rfmagdy@gmail.com

# SMTP account that sends the email (Gmail example: needs 2-Step Verification + an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM="Mohamed Elsaeed – Website <your-sending-account@gmail.com>"

# WhatsApp number in international format, digits only (e.g. 201001234567)
# Optional: overrides the number in src/lib/site.ts
NEXT_PUBLIC_WHATSAPP_NUMBER=

# The site's public address once published (used for link previews), e.g. https://mohamedelsaeed.com
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID (e.g. G-ABC123XYZ). Leave empty to load no analytics at all.
NEXT_PUBLIC_GA_ID=

# Google Search Console "HTML tag" verification code (only the content value). Leave empty if verified another way.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
